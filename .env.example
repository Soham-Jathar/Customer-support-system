# Default local development database is SQLite. Uncomment and configure this only when PostgreSQL is running.
# DATABASE_URL=postgresql+psycopg://support_user:change_this_for_real_deployment@localhost:5432/support_triage
AGENT_ACCESS_KEY=replace-with-a-long-random-local-demo-key
API_URL=http://127.0.0.1:8000
